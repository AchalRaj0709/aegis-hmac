# AegisHMAC Environment Configuration Example
# Copy this file to .env and fill in real secrets

# Application Settings
APP_NAME=AegisHMAC
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=aegis_hmac_db

# Cryptographic Master Key for Envelope Encryption (32-byte / 64-hex char AES-GCM Key)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security & Temporal Verification Tolerances
CLOCK_SKEW_TOLERANCE_SECONDS=300
NONCE_TTL_SECONDS=300
DEFAULT_ALGORITHM=HMAC-SHA256
